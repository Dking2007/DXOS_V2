# Reference only. Run `python scripts/bootstrap.py` to generate local values.
# Never deploy production with this development Compose unchanged.
PUBLIC_BASE_URL=http://localhost:8080
GATEWAY_PORT=8080
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_RANDOM
CORE_DB_PASSWORD=REPLACE_WITH_RANDOM
WORKSPACE_DB_PASSWORD=REPLACE_WITH_RANDOM
IDENTITY_DB_PASSWORD=REPLACE_WITH_RANDOM
KEYCLOAK_ADMIN=dx-admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_RANDOM
WORKSPACE_CLIENT_SECRET=REPLACE_WITH_RANDOM
CORE_ADMIN_CLIENT_SECRET=REPLACE_WITH_RANDOM
WORKSPACE_SERVICE_CLIENT_SECRET=REPLACE_WITH_RANDOM
CORE_EXAMPLE_CLIENT_SECRET=REPLACE_WITH_RANDOM
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
S3_ACCESS_KEY=REPLACE_WITH_RANDOM
S3_SECRET_KEY=REPLACE_WITH_RANDOM
ONLYOFFICE_JWT_SECRET=REPLACE_WITH_RANDOM
ONLYOFFICE_ENABLED=false
# Hostnames automation webhooks may call, comma-separated (e.g. hooks.example.org).
# Empty keeps outbound automation calls disabled.
AUTOMATION_ALLOWED_HOSTS=
# Compose reads this as ${COOKIE_SECURE:-false}; bootstrap writes true only for an
# https:// --base-url. Leave false for local HTTP development.
COOKIE_SECURE=false
