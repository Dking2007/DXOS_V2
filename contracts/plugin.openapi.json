        "description": "The plugin finished a long-running step; only the first report counts.",
        "operationId": "complete_call_workspace_v1_plugin_v1_calls__call_id__complete_post",
        "parameters": [
          {
            "name": "call_id",
            "in": "path",
            "required": true,
